<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sc_mail_link_view_list" model="ir.ui.view">
        <field name="name">sc.mail.link.list</field>
        <field name="model">sc.mail.link</field>
        <field name="arch" type="xml">
            <list>
                <field name="received_at"/>
                <field name="po_id"/>
                <field name="direction"/>
                <field name="confidence"/>
                <field name="case_id" optional="hide"/>
                <field name="graph_conversation_id" optional="hide"/>
                <field name="web_link" widget="url" string="Open in Outlook"/>
            </list>
        </field>
    </record>

    <record id="sc_mail_link_action" model="ir.actions.act_window">
        <field name="name">Mail links</field>
        <field name="res_model">sc.mail.link</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No linked messages yet</p>
            <p>Only identifiers are stored here; open the message in Outlook.</p>
        </field>
    </record>
</odoo>
