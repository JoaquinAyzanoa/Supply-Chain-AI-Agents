# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Prefix SC__, nested sections with __ (see src/sc_core/sc_core/infra/settings.py).

# --- service ----------------------------------------------------------------
# SC__SERVICE_NAME is set per container by the Dockerfile; only set it here for
# `python -m sc_core.app.run` outside docker.
#SC__SERVICE_NAME=director
SC__ENVIRONMENT=dev            # dev | test | staging | prod
SC__LOG_LEVEL=INFO             # TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
#SC__LOG_JSON=false            # unset: JSON outside dev
SC__TIMEZONE=America/Lima

# --- http ------------------------------------------------------------------
SC__HTTP__HOST=0.0.0.0
SC__HTTP__PORT=8000
SC__HTTP__MAX_REQUEST_BYTES=1048576
SC__HTTP__ENABLE_HSTS=false
SC__HTTP__ACCESS_LOG=false

# --- application database (checkpoints, cases, mail links, jobs) -------------
# From the host use port 15432 (SC_APP_DB_PORT); inside compose the agents use app-db:5432.
SC__APP_DB__DSN=postgresql://app:app@localhost:15432/app
SC__APP_DB__POOL_MIN=1
SC__APP_DB__POOL_MAX=10
SC__APP_DB__MIGRATIONS_DIR=migrations

# --- redis (locks, pub/sub) --------------------------------------------------
SC__REDIS__DSN=redis://localhost:6379/0

# --- odoo ---------------------------------------------------------------------
# From the host use localhost:8069; inside compose the agents use http://odoo:8069.
SC__ODOO__URL=http://localhost:8069
SC__ODOO__DB=scai
SC__ODOO__LOGIN=sc_agent_bot
# Generated by `just odoo-apikey` after `just odoo-init`.
SC__ODOO__API_KEY=
SC__ODOO__TIMEOUT_SECONDS=30
#SC__ODOO__LANG=es_PE            # only if that language is installed in Odoo; empty = bot user's language
SC__ODOO__TZ=America/Lima

# --- microsoft graph (see README: Email setup) ----------------------------------
SC__MAIL__AUTH_MODE=delegated           # delegated (dev, personal mailbox) | application (prod, shared mailbox)
SC__MAIL__CLIENT_ID=                    # Application (client) ID of the app registration
SC__MAIL__AUTHORITY=https://login.microsoftonline.com/consumers
SC__MAIL__MAILBOX=me                    # "me" in delegated mode; the shared address in application mode
SC__MAIL__POLL_INTERVAL_MINUTES=30
#SC__MAIL__TENANT_ID=                   # application mode only
#SC__MAIL__CLIENT_SECRET=               # application mode only

# --- llm providers (OpenAI-compatible; see src/sc_core/sc_core/llm/models.yaml) -------
DEEPSEEK_API_KEY=                       # required for the default model
#OPENAI_API_KEY=                        # only when an agent is assigned gpt-5.x
SC__LLM__DEFAULT_MODEL=deepseek-v4-flash
#SC__LLM__MODEL__DIRECTOR=deepseek-v4-flash        # per-agent override, name upper-cased
#SC__LLM__MODEL__SUPPLIER_COMMS=gpt-5.4
SC__LLM__BUDGET_MAX_USD=2.0             # per run; agents may lower it
SC__LLM__RECORD_MODE=off                # off | record | replay (test fixtures)

# --- langfuse (self-hosted via compose; keys created on first boot) -------------------
SC__LANGFUSE__ENABLED=true
SC__LANGFUSE__HOST=http://localhost:3000            # inside compose: http://langfuse-web:3000
SC__LANGFUSE__PUBLIC_KEY=pk-lf-scai-dev
SC__LANGFUSE__SECRET_KEY=sk-lf-scai-dev-secret
SC__LANGFUSE__MASK_INPUTS=false         # true redacts email text from traces

# --- events, mail sync and scheduler (phase 4) ------------------------------------
# Shared secret that signs every internal event (mail_sync/scheduler -> director).
# Generate your own for anything beyond a laptop: python -c "import secrets; print(secrets.token_hex(32))"
SC__EVENTS__SIGNING_SECRET=dev-signing-secret-change-me
SC__EVENTS__DIRECTOR_URL=http://localhost:8010    # inside compose: http://director:8000
SC__MAIL_SYNC__URL=http://localhost:8011          # inside compose: http://mail_sync:8000
SC__MAIL_SYNC__PAGE_SIZE=50
SC__MAIL_SYNC__LOCK_TTL_SECONDS=1500
SC__SCHEDULER__MAIL_SYNC_CRON=*/30 * * * *        # five-field crontab, evaluated in SC__TIMEZONE
SC__SCHEDULER__PO_FOLLOWUPS_CRON=0 9 * * 1-5
SC__SCHEDULER__INVENTORY_PLANNING_CRON=0 6 * * *
SC__SCHEDULER__SUPPLIER_PERFORMANCE_CRON=0 7 * * 1

# --- langgraph agents (phase 5) --------------------------------------------------------
SC__AGENTS__APPROVER_USER_ID=2          # Odoo user who gets the approval To-Do (demo: 2 = Administrator)
SC__AGENTS__APPROVAL_DEADLINE_DAYS=2
SC__AGENTS__MAX_TOOL_ROUNDS=6           # model <-> tools loop cap per node
#SC__A2A__TOKEN=                        # bearer for agent calls; empty = reuse SC__EVENTS__SIGNING_SECRET
SC__A2A__TIMEOUT_SECONDS=300
SC__A2A__SUPPLIER_COMMS_URL=http://localhost:8013   # inside compose: http://supplier_comms:8000

# --- supplier communications agent (phase 5) ------------------------------------------
SC__SUPPLIER_COMMS__PUBLIC_URL=http://localhost:8013   # inside compose: http://supplier_comms:8000
#SC__SUPPLIER_COMMS__AUTO_SEND_PARTNER_IDS=["12","34"]  # JSON list of partner ids trusted to send without approval
