{
  "additionalProperties": false,
  "description": "What the director asks the supplier communications agent to do.",
  "properties": {
    "assigned_po_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "resolve_unlinked: a person named the order; link it without asking the model",
      "title": "Assigned Po Name"
    },
    "candidate_po_names": {
      "description": "resolve_unlinked: orders the sender may refer to",
      "items": {
        "type": "string"
      },
      "title": "Candidate Po Names",
      "type": "array"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "days_silent": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "follow_up: days without reply",
      "title": "Days Silent"
    },
    "graph_message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "inbound message to handle",
      "title": "Graph Message Id"
    },
    "kind": {
      "enum": [
        "send_rfq",
        "request_eta",
        "follow_up",
        "send_po",
        "handle_inbound",
        "resolve_unlinked",
        "decline_quote",
        "counter_offer",
        "internal_request",
        "status_reply"
      ],
      "title": "Kind",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "buyer's instructions for the draft",
      "title": "Notes"
    },
    "po_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Odoo order name, e.g. P00015",
      "title": "Po Name"
    },
    "pre_approved": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the content was approved upstream (an award, a counter-offer): send without a second approval; the text says which approval",
      "title": "Pre Approved"
    },
    "require_approval": {
      "default": false,
      "description": "a person asked for this email from the Control Tower: show the draft for approval before sending, whatever the automatic-send rules say",
      "title": "Require Approval",
      "type": "boolean"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "case_id"
  ],
  "title": "SupplierCommsTask",
  "type": "object"
}
