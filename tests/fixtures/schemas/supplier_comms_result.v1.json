{
  "$defs": {
    "ChangeProposal": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ProposedChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "changes",
        "summary"
      ],
      "title": "ChangeProposal",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "kind": {
          "enum": [
            "quotation",
            "eta_update",
            "question",
            "shipping_notice",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "confidence",
        "reason"
      ],
      "title": "Classification",
      "type": "object"
    },
    "OutboundSummary": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Attachments",
          "type": "array"
        },
        "draft_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Id"
        },
        "kind": {
          "enum": [
            "rfq",
            "request_eta",
            "follow_up",
            "send_po",
            "reply",
            "discrepancy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sent_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sent Message Id"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "items": {
            "type": "string"
          },
          "title": "To",
          "type": "array"
        },
        "web_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Web Link"
        }
      },
      "required": [
        "kind",
        "to",
        "subject"
      ],
      "title": "OutboundSummary",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "status": {
          "enum": [
            "sent",
            "applied",
            "awaiting_approval",
            "rejected",
            "no_action",
            "escalated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "ProposedChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "field": {
          "enum": [
            "date_planned",
            "price",
            "lead_days"
          ],
          "title": "Field",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "po_line_id": {
          "title": "Po Line Id",
          "type": "integer"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "review_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Reason"
        },
        "source": {
          "default": "supplier",
          "enum": [
            "supplier",
            "tracking",
            "estimated"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "po_line_id",
        "product",
        "field",
        "before",
        "after",
        "confidence"
      ],
      "title": "ProposedChange",
      "type": "object"
    },
    "QuotationData": {
      "additionalProperties": false,
      "description": "Structured content of a supplier reply: prices, lead times and the delivery date.",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "eta_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date the agent derived",
          "title": "Eta Date"
        },
        "eta_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the date as the supplier wrote it",
          "title": "Eta Date Raw"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/QuotedLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "QuotationData",
      "type": "object"
    },
    "QuotedLine": {
      "additionalProperties": false,
      "description": "One product as the supplier quoted it, mapped to our order line when possible.",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "lead_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Days"
        },
        "min_qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Qty"
        },
        "po_line_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "matching purchase.order.line id",
          "title": "Po Line Id"
        },
        "product_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "supplier's product reference",
          "title": "Product Ref"
        },
        "qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qty"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        }
      },
      "required": [
        "description"
      ],
      "title": "QuotedLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the agent returns to the director (also when paused on an approval).",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "chosen_po_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "resolve_unlinked: the pick",
      "title": "Chosen Po Name"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Classification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extracted": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuotationData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "send_rfq",
        "request_eta",
        "follow_up",
        "send_po",
        "handle_inbound",
        "resolve_unlinked"
      ],
      "title": "Kind",
      "type": "string"
    },
    "outbound": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutboundSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "po_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Po Name"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangeProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "kind",
    "case_id",
    "run_id",
    "outcome"
  ],
  "title": "SupplierCommsResult",
  "type": "object"
}
