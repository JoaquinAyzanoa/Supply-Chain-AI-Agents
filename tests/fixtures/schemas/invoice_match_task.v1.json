{
  "additionalProperties": false,
  "description": "What the director asks the invoice matching agent to do.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "graph_message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the supplier's email with the invoice attached",
      "title": "Graph Message Id"
    },
    "kind": {
      "const": "match_bill",
      "title": "Kind",
      "type": "string"
    },
    "move_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "a vendor bill typed in Odoo",
      "title": "Move Id"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "po_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the order, when already known",
      "title": "Po Name"
    },
    "require_approval": {
      "default": false,
      "description": "a person asked; show it first",
      "title": "Require Approval",
      "type": "boolean"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "case_id"
  ],
  "title": "InvoiceMatchTask",
  "type": "object"
}
