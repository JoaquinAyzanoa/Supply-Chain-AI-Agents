      "required": [
        "line_id",
        "product_id",
        "product_ref",
        "warehouse_id",
        "on_hand",
        "incoming",
        "position",
        "forecast_daily",
        "forecast_method",
        "sigma_daily",
        "history_periods",
        "lead_time_days",
        "sigma_lead_time_days",
        "service_level",
        "review_period_days",
