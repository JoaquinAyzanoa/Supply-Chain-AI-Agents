{
  "$defs": {
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "status": {
          "enum": [
            "sent",
            "applied",
            "awaiting_approval",
            "rejected",
            "no_action",
            "escalated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "PerformanceApplied": {
      "additionalProperties": false,
      "properties": {
        "partners": {
          "default": 0,
          "title": "Partners",
          "type": "integer"
        },
        "planning_params": {
          "default": 0,
          "title": "Planning Params",
          "type": "integer"
        },
        "price_list_entries": {
          "default": 0,
          "title": "Price List Entries",
          "type": "integer"
        }
      },
      "title": "PerformanceApplied",
      "type": "object"
    },
    "SupplierScore": {
      "additionalProperties": false,
      "description": "One supplier's numbers for a period, the model's paragraph and the flagged changes.",
      "properties": {
        "lead_time_mean_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Time Mean Days"
        },
        "lead_time_sigma_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Time Sigma Days"
        },
        "otif": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Otif"
        },
        "partner_id": {
          "title": "Partner Id",
          "type": "integer"
        },
        "partner_name": {
          "minLength": 1,
          "title": "Partner Name",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "price_cv": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Cv"
        },
        "promise_drift_days": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promise Drift Days"
        },
        "quality_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Rate"
        },
        "response_hours_median": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Hours Median"
        },
        "samples": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Samples",
          "type": "object"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "scorecard": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorecard"
        },
        "trends": {
          "items": {
            "type": "string"
          },
          "title": "Trends",
          "type": "array"
        }
      },
      "required": [
        "partner_id",
        "partner_name",
        "period_start",
        "period_end",
        "score"
      ],
      "title": "SupplierScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/PerformanceApplied"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "kind": {
      "const": "weekly_scorecard",
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period End"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Start"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/SupplierScore"
      },
      "title": "Scores",
      "type": "array"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "kind",
    "case_id",
    "run_id",
    "outcome"
  ],
  "title": "SupplierPerformanceResult",
  "type": "object"
}
